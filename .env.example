# Provider credentials: server-side only. Never use NEXT_PUBLIC_ prefixes.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional model overrides (defaults are documented in docs/ai/orchestration.md).
GEMINI_MODEL=
GROQ_MODEL=

# Required to enable the protected /api/chat endpoint.
# Generate locally with: openssl rand -base64 48
# Keep this secret out of browser code and never commit the real value.
OZLIND_AI_ACCESS_TOKEN=
