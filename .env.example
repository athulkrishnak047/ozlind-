# Provider credentials: server-side only. Never use NEXT_PUBLIC_ prefixes.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional model overrides (defaults are documented in docs/ai/orchestration.md).
GEMINI_MODEL=
GROQ_MODEL=

# Required in production for atomic, cross-instance public API rate limits.
# Create a Redis database with Upstash and copy its REST URL and REST token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
